# Copying this file does not generate usable credentials.
# Run: python3 scripts/init-lab-env.py (refuses to overwrite an existing .env).
# All values below are local lab placeholders; never use them as credentials.
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
POSTGRES_ADMIN_PASSWORD=
CW_DATABASE_PASSWORD=
REDIS_PASSWORD=
LAB_USER_PASSWORD=
# DISABLE_ENTERPRISE=true and CW_EDITION=ce are enforced in Compose/Dockerfile.
# Immutable image references are provided by infra/images.lock.env.
# No messenger credentials belong in the stage-1 lab.

# Server: generate real values with scripts/server/prepare-env.py, not this template.
COMPOSE_PROJECT_NAME=pravburo-chatwoot
SERVER_PREPARED_ONLY=true
HTTP_PORT=8088
FRONTEND_URL=http://localhost:8088
TELEGRAM_MODE=personal
CORPORATE_ACCOUNT_ID=1
CORPORATE_INBOX_ID=1
INTEGRATION_DB_PASSWORD=
DJANGO_SECRET_KEY=
CW_SERVICE_TOKEN=
INTEGRATION_API_TOKEN=
GATEWAY_TOKEN=
CW_WEBHOOK_SECRET=

CW_IMAGE_NAME=corporate-chatwoot-ce:server
INTEGRATION_IMAGE=corporate-chatwoot-integration:server
GATEWAY_IMAGE=corporate-telegram-gateway:server

# Bitrix secrets are configured only on the server, never in source or a browser.
BITRIX_ENABLED=false
CORPORATE_SHARED_INTAKE_ENABLED=false
BITRIX_WEBHOOK_URL=
BITRIX_DIRECTORY_WEBHOOK_URL=
BITRIX_PORTAL_URL=
BITRIX_MANAGER_CHAT_FIELD=UF_CRM_CW_MANAGER_CHAT
BITRIX_SUPERVISOR_CHAT_FIELD=UF_CRM_CW_SUPERVISOR_CHAT
